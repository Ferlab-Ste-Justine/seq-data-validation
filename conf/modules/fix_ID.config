/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    withName: 'RENAME_FASTQ' {
        publishDir = [
            path: { "${params.outdir}/ID_replace/fastq" },
            mode: params.publish_dir_mode,
            saveAs: {filename -> filename.contains("${meta.old_id}") ? null : filename}
        ]
    }

    withName: '.*BAM_ID_REPAIR:SAMTOOLS_REHEADER|.*BAM_ID_REPAIR:SAMTOOLS_INDEX' {
        publishDir = [
            path: { "${params.outdir}/ID_replace/alignments" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: '.*BAM_ID_REPAIR:SAMTOOLS_REHEADER' {
        ext.args = '--no-PG'
    }

    withName: '.*BAM_ID_REPAIR:SAMTOOLS_ADDREPLACERG' {
        ext.args = '--no-PG'
        ext.prefix = { "${meta.id}.addreplacerg" }
    }

    withName: '.*VCF_ID_REPAIR:BCFTOOLS_REHEADER' {
        ext.args   = ''
        ext.args2  = {"--output-type z --write-index=tbi --no-version" }
        // TODO: naming convention for re-headed vcfs
        ext.prefix = { vcf.baseName - ".vcf" + ".reheader"}
        publishDir = [
            path: { "${params.outdir}/ID_replace/variants" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
