/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run Ferlab-Ste-Justine/seq-data-validation -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 2,
        memory: '6.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data
    input  = 'data-test/testSamplesheet.csv'

    outdir = "results"
    publish_all = true

    replace_sample_id = true
    id_mapping = "${projectDir}/assets/id_mapping.csv"
    path_in_manifest = true
    fasta = "data-test/reference/Homo_sapiens_assembly38/chr22/chr22.fa"
    fai = "data-test/reference/Homo_sapiens_assembly38/chr22/chr22.fa.fai"
    fasta_dict = "data-test/reference/Homo_sapiens_assembly38/chr22/chr22.dict"
}
