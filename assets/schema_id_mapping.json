{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/Ferlab-Ste-Justine/seq-data-validation/master/assets/schema_id_mapping.json",
    "title": "Ferlab-Ste-Justine/seq-data-validation pipeline - params.id_mapping schema",
    "description": "Schema for the file provided with params.id_mapping",
    "type": "array",
    "required": ["oldID", "newID"],
    "allOf": [{ "uniqueEntries": ["oldID"] }, { "uniqueEntries": ["newID"] }, { "uniqueEntries": ["oldID", "newID"] }],
    "items": {
        "type": "object",
        "properties": {
            "newID": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "newID must be provided and cannot contain spaces"
            },
            "oldID": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "oldID must be provided and cannot contain spaces"
            }
        }
    }
}
